generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model categories {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String?
  description String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model contact_settings {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone         String
  email         String
  address       String
  working_hours String
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model hero_banners {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  image       String
  button_text String?
  button_link String?
  active      Boolean   @default(false)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model inventory {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id      String
  stock           Int
  reserved_stock  Int
  low_stock_limit Int
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model order_items {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id   String
  product_id String
  quantity   Int
  price      Float
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model orders {
  id           String    @id(map: "order _pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String?
  total_amount Float?
  status       String?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model payment_setting {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  upi_id              String
  qr_coad             String
  account_name        String
  payment_instruction String
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model payments {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id_          String    @map("order_id ")
  user_id            String
  amount             Float
  payment_method     String
  utr_number         String    @unique
  payment_screenshot String?
  status             String    @default("pending")
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  updated_at         DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model products {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Name        String?   @unique
  Description String?
  Price       Float
  Image__     String?   @map("Image  ")
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model shipping_settings {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  free_shipping_limit Float
  shipping_charge     Float
  estimated_delivery  String
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  email      String    @unique
  phone      String
  role       String
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model website_settings {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  logo            String
  website_name    String
  whatsaap_number String
  imstagram_link  String
  support_email   String
  address         String
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)
}
